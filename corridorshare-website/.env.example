# CorridorShare website environment
# Copy to .env.local for local development: cp .env.example .env.local

# Data source: "supabase" (default) or "demo" (local-only, never in production)
NEXT_PUBLIC_DATA_MODE=supabase

# Required when NEXT_PUBLIC_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional public storage bucket names (defaults match backend MVP migration)
NEXT_PUBLIC_STORAGE_BUCKET_INSPECTION=parcel-inspections
NEXT_PUBLIC_STORAGE_BUCKET_NID=nid-photos
