rules_version = '2';

// CorridorShare Storage security rules — foundation (Increment 1).
//
// Only the identity (NID) bucket is open. Each user can write to their own
// `users/{uid}/nid/{file}` path. Read access is restricted to the owner and
// to admins who perform the verification (Increment 4).

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /users/{userId}/nid/{file=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
